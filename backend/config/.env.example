# Example environment for Gmail SMTP + Google OAuth (copy to backend/config/.env and fill values)
# Use Gmail app passwords if your account has 2FA enabled. Create an app password at:
# https://myaccount.google.com/apppasswords

# ===================================
# Email Driver Configuration
# ===================================
# Options: 'smtp', 'brevo', 'sendgrid', or 'resend'
# 
# 'smtp' - Gmail/custom SMTP (requires SMTP ports - NOT available on InfinityFree)
# 'brevo' - Brevo API (RECOMMENDED! Works on InfinityFree, accepts Gmail, 300/day free!)
# 'sendgrid' - SendGrid API (requires business email for signup, 100/day free)
# 'resend' - Resend API (requires domain verification for production, 3000/month free)
#
# RECOMMENDED FOR INFINITYFREE: brevo (accepts Gmail, no business email needed!)
MAIL_DRIVER=smtp

# Gmail SMTP settings (only used if MAIL_DRIVER=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Brevo API settings (only used if MAIL_DRIVER=brevo)
# Sign up at https://www.brevo.com with your Gmail - no business email needed!
# Get API key from https://app.brevo.com/settings/keys/api
# NO domain verification needed! Works immediately!
BREVO_API_KEY=xkeysib-your_key_here

# SendGrid API settings (only used if MAIL_DRIVER=sendgrid)
# NOTE: Requires business email for signup
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# Resend API settings (only used if MAIL_DRIVER=resend)
# NOTE: Requires domain verification to send to ANY email
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email sender details (used by all drivers)
# For Brevo/SendGrid: Use any email (e.g., 'noreply@fitsync.com')
# For Resend testing: Use 'onboarding@resend.dev'
# For SMTP: Usually same as EMAIL_USER
EMAIL_FROM=noreply@fitsync.com
EMAIL_FROM_NAME=FitSync Support

# Debugging
DEBUG_MAIL=1
FORCE_IPV4=0

# App URLs used when building links in emails
FRONTEND_URL=http://localhost:5174
APP_URL=http://localhost/personalized-fitness-workout/backend/public

# Google OAuth (fill these with values from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/personalized-fitness-workout/backend/public/google_callback.php


# ===================================
# AI Provider Configuration
# ===================================
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration  
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# Security Configuration
# ===================================
# Session Security (production with HTTPS)
SESSION_SECURE=false  # Set to true in production with HTTPS
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax  # or Strict for tighter security

# CSRF Protection
CSRF_PROTECTION_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5        # Max login attempts
RATE_LIMIT_LOGIN_WINDOW=300   # in seconds (5 minutes)
RATE_LIMIT_API_MAX=60          # Max API calls
RATE_LIMIT_API_WINDOW=60       # in seconds (1 minute)



